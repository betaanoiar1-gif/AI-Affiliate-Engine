# Safe default: no external publishing
AFFILIATE_RUN_MODE=simulation
KILL_SWITCH=false
DEFAULT_COUNTRY=DZ
MAX_DAILY_PUBLICATIONS=3
REQUEST_TIMEOUT_SECONDS=15
AI_MONTHLY_BUDGET=0

# Free-first cloud AI. Configure only providers you actually have access to.
# Do not assume a free quota is unlimited; provider limits and model availability change.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
HF_TOKEN=
HF_MODEL=

# Optional custom OpenAI-compatible provider (kept for paid or self-managed fallback)
AI_BASE_URL=
AI_MODEL=
AI_COST_PER_1K=0
AI_API_KEY=

# Optional affiliate providers; program/network eligibility is separate from API cost.
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
PARTNERSTACK_API_KEY=

# Optional operator-supplied RSS trend feed
TREND_RSS_URL=

# Public no-key trend sources used by the free-first research layer include
# Hacker News API, Google Trends RSS, Reddit RSS, and YouTube/channel RSS where available.
