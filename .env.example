# Safe default: no external publishing
AFFILIATE_RUN_MODE=simulation
KILL_SWITCH=false
DEFAULT_COUNTRY=DZ
MAX_DAILY_PUBLICATIONS=3
REQUEST_TIMEOUT_SECONDS=15
AI_MONTHLY_BUDGET=0

# Optional OpenAI-compatible AI provider
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_COST_PER_1K=0
AI_API_KEY=

# Optional affiliate providers
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
PARTNERSTACK_API_KEY=

# Optional operator-supplied RSS trend feed
TREND_RSS_URL=
